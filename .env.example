# VK Callback API
# Токен сообщества с разрешениями на сообщения и документы
VK_ACCESS_TOKEN=your_vk_group_access_token_here
# Совпадает с секретным ключом Callback API в настройках сообщества
VK_CALLBACK_SECRET=your_vk_callback_secret_here
# Код подтверждения Callback API из настроек сообщества
VK_CONFIRMATION_CODE=your_confirmation_code_here
VK_API_VERSION=5.199
# Адрес, на котором слушает бот (nginx проксирует сюда через proxy_pass)
HOST=127.0.0.1
PORT=3000
# Путь, на который ВК шлёт события (должен совпадать с location в nginx)
VK_CALLBACK_PATH=/

# База данных
DATABASE_URL=sqlite+aiosqlite:///documents.db

# LLM (необязательно, LM Studio OpenAI-compatible API)
LLM_API_URL=http://127.0.0.1:1234/v1
LLM_MODEL=your_model_name_here

# Файлы
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads/documents